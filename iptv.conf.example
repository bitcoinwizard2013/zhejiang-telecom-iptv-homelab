# Copy to /etc/iptv-homelab/iptv.conf and chmod 600. Plain KEY=value, no quotes.
# No shell expansion. Never commit the completed configuration.
IPTV_INTERFACE=YOUR_DEDICATED_INTERFACE
STB_MAC_HEX=YOUR_12_HEX_DIGITS
OPTION60_HEX=YOUR_CAPTURED_OPTION60_HEX
DHCP_HOSTNAME=YOUR_CAPTURED_HOSTNAME
IPTV_PREFIXES=192.0.2.0/24,198.51.100.0/24
IP_BINARY=/sbin/ip
STATE_FILE=/var/run/iptv-homelab/access.state
HTTP_BIND=127.0.0.1
HTTP_PORT=8554
HTTP_BASE=http://127.0.0.1:8554
CLIENT_CIDRS=127.0.0.1/32
UPSTREAM_CIDRS=192.0.2.0/24,198.51.100.0/24
UPSTREAM_PORTS=554
SOURCE_M3U=/etc/iptv-homelab/channels.m3u
MAX_CLIENTS=4
IO_TIMEOUT=10
KEEPALIVE_SECONDS=20
