#!/bin/sh /etc/rc.common
# MIT. No service is enabled automatically by install.sh.
START=98
STOP=10
USE_PROCD=1
start_service() {
    [ -r /etc/iptv-homelab/iptv.conf ] || return 1
    [ -r /etc/iptv-homelab/channels.m3u ] || return 1
    procd_open_instance access
    procd_set_param command /usr/bin/perl /opt/iptv-homelab/iptv_access.pl --watch /etc/iptv-homelab/iptv.conf
    procd_set_param respawn 3600 10 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
    procd_open_instance gateway
    procd_set_param command /usr/bin/perl /opt/iptv-homelab/iptv_gateway.pl /etc/iptv-homelab/iptv.conf
    procd_set_param respawn 3600 10 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
