# Historical planning example only. Runtime uses iptv.conf.example; see RUNTIME.md.
# Documentation only. No installer loads this file.
# Replace every YOUR_... item using your own verified configuration.
# Never commit the completed file or authentication material.
IPTV_INTERFACE=YOUR_IPTV_INTERFACE
LAN_INTERFACE=YOUR_LAN_INTERFACE
IPTV_GATEWAY=YOUR_IPTV_GATEWAY
IPTV_SOURCE_PREFIX=YOUR_VERIFIED_PREFIX
HTTP_BIND_ADDRESS=YOUR_LAN_ADDRESS
HTTP_PORT=8554
PLAYLIST_URL=http://YOUR_GATEWAY:8554/playlist.m3u
# Authentication belongs in a separate local-only file, not in this example.
